{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      { "varsIgnorePattern": "^[A-Z_]" }
    ],
    "react/exhaustive-deps": "warn",
    "react/only-export-components": "warn",
    "react/set-state-in-effect": "warn"
  },
  "ignorePatterns": ["**/dist/**"]
}
